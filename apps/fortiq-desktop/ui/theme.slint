export global FortiqTheme {
    in-out property <color> background: #0b1220;
    in-out property <color> surface: #101a2a;
    in-out property <color> surface-hover: #172337;
    in-out property <color> surface-elevated: #1e2d42;
    in-out property <color> border: #203048;
    in-out property <color> primary: #0b84ff;
    in-out property <color> primary-hover: #0070e0;
    in-out property <color> danger: #e5484d;
    in-out property <color> danger-hover: #d13438;
    in-out property <color> success: #16a36d;
    in-out property <color> warning: #eaa612;
    in-out property <color> text-primary: #eef4fb;
    in-out property <color> text-secondary: #8fa0b5;
    in-out property <color> text-muted: #536478;

    in-out property <length> spacing-xs: 4px;
    in-out property <length> spacing-sm: 8px;
    in-out property <length> spacing-md: 12px;
    in-out property <length> spacing-lg: 16px;
    in-out property <length> spacing-xl: 24px;

    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 12px;
}
