{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORTIQ",
  "version": "0.1.0",
  "identifier": "com.fortiq.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FORTIQ — Support & Supervision Souveraine",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Sovereign P2P Remote Administration Desktop",
    "longDescription": "FORTIQ is a sovereign peer-to-peer remote administration client with end-to-end authenticated QUIC transport, ConPTY/PTY terminal streaming, and ticket-gated session authorization.",
    "copyright": "2026 FORTIQ Contributors",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  }
}
