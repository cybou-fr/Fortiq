<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets/icon.ico" />
    <AvaloniaResource Include="..\..\assets\icon.png" Link="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fortiq.Desktop.ViewModels\Fortiq.Desktop.ViewModels.csproj" />
    <ProjectReference Include="..\Fortiq.Provisioning\Fortiq.Provisioning.csproj" />
    <ProjectReference Include="..\Fortiq.Monitoring\Fortiq.Monitoring.csproj" />
    <ProjectReference Include="..\Fortiq.Operations\Fortiq.Operations.csproj" />
    <ProjectReference Include="..\Fortiq.Scheduling\Fortiq.Scheduling.csproj" />
    <ProjectReference Include="..\Fortiq.Infrastructure.ObjectStorage\Fortiq.Infrastructure.ObjectStorage.csproj" />
    <ProjectReference Include="..\Fortiq.Infrastructure.Receipts\Fortiq.Infrastructure.Receipts.csproj" />
    <ProjectReference Include="..\Fortiq.Platform.Windows\Fortiq.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
