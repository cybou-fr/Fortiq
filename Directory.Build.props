<Project>
  <!--
    The one place a Fortiq version is decided. Everything that shows or records a version reads it
    from here: the assemblies, the version on the Settings screen, the deployment bundle's manifest
    and the name of the release archive. It was decided in none of those places before, so the ZIP
    said 0.1.0 while the application said 1.0.0 - the default nobody chose.

    VersionPrefix is the release. VersionSuffix marks a pre-release ("beta.1") and is empty for a
    final one; scripts/Get-FortiqVersion.ps1 reads both.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <Product>Fortiq Community Edition</Product>
    <Company>Fortiq</Company>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Keep executable helpers reached through library references in the same runtime graph
         during bundle publication; the SDK otherwise mixes RID-neutral and RID-specific outputs. -->
    <RuntimeIdentifier Condition="'$(FortiqPublishRuntime)' != ''">$(FortiqPublishRuntime)</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)assets\icon.png')" Visible="false" />
  </ItemGroup>
</Project>
