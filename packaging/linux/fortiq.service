[Unit]
Description=FORTIQ Sovereign Remote Administration Node
Documentation=https://github.com/cybou-fr/Fortiq
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fortiq-service --config /etc/fortiq/fortiq.toml
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
RuntimeDirectory=fortiq
RuntimeDirectoryMode=0770

# Security hardening
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
