# Fortiq repository ignores

# User-requested exclusions
.idea/

# Engine downloads & binaries
engines/restic/

# Build artifacts (.NET)
**/[Bb]in/
**/[Oo]bj/
[Bb]uild/
TestResults/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl

# IDE & Editor files
.vs/
.vscode/
*.DotSettings.user
*.DotSettings
_ReSharper*/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary files
*.log
*.tmp
*.bak

# CI evidence produced by test runs
/artifacts/

# Test-only tools acquired by scripts/Get-TestStorage.ps1
/tools/

# Credentials, belt and braces. Test keys live outside the working tree entirely, which is the
# actual protection; these rules only catch a file somebody creates here by habit.
*.secrets.json
secrets/
.env
.env.*
s3-test.ps1
